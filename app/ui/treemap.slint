import { Palette } from "std-widgets.slint";

/// Names of the keys the host uses, shared by the file tree and the treemap.
export global Keys {
    /// Name of the key for the host, or "" for a key the host does not use.
    public pure function name(text: string) -> string {
        if (text == Key.UpArrow) { return "up"; }
        if (text == Key.DownArrow) { return "down"; }
        if (text == Key.LeftArrow) { return "left"; }
        if (text == Key.RightArrow) { return "right"; }
        if (text == Key.Return) { return "enter"; }
        if (text == " ") { return "space"; }
        if (text == Key.Backspace) { return "backspace"; }
        return "";
    }
}

/// The label of one frame, on its band, in logical pixels. Text is formatted by the host.
export struct FrameLabel {
    x: length,
    y: length,
    width: length,
    height: length,
    name: string,
    size: string,
}

/// The label of one file tile, on the tile, in logical pixels. Text is formatted by the host.
export struct FileLabel {
    x: length,
    y: length,
    width: length,
    height: length,
    name: string,
    size: string,
    /// Text colour that reads on the tile colour.
    ink: color,
    /// The size goes on a second line under the name.
    two-lines: bool,
}

/// The node under the pointer, in logical pixels. Set by the host only when that node changes.
export struct Hover {
    /// A node is under the pointer.
    visible: bool,
    x: length,
    y: length,
    width: length,
    height: length,
    /// A file tile: it lifts and glows in `color`. A folder frame gets a light highlight.
    lift: bool,
    /// The colour of the file type of the tile.
    color: color,
    /// The tile is big enough for its name: `label` is shown on the lifted tile.
    labelled: bool,
    /// The label of the tile, in the tile's own coordinates.
    label: FileLabel,
    /// The tooltip: the full path, then the size and the file type or the number of files.
    title: string,
    detail: string,
}

/// One crumb above the treemap. Text is formatted by the host.
export struct Crumb {
    text: string,
    /// The node the crumb opens, or -1 for the gap crumb, which opens nothing.
    index: int,
}

/// One crumb: a link that opens its folder, by mouse, Enter or Space.
component CrumbLink inherits Rectangle {
    in property <Crumb> crumb;
    /// The folder the treemap shows: the last crumb.
    in property <bool> current;
    callback open(int);

    // A long name is cut with "…" when the crumbs do not fit; a short name is never cut.
    min-width: min(label.preferred-width, 64px) + 12px;
    max-width: 240px;
    border-radius: 4px;
    background: touch.has-hover ? Palette.alternate-background : transparent;
    border-width: focus.has-focus ? 2px : 0px;
    border-color: Palette.accent-background;
    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        label := Text {
            text: root.crumb.text;
            vertical-alignment: center;
            overflow: elide;
            font-weight: root.current ? 600 : 400;
            color: root.current ? Palette.foreground : Palette.foreground.transparentize(35%);
            accessible-role: none;
        }
    }
    focus := FocusScope {
        accessible-role: button;
        accessible-label: "Open \{root.crumb.text}";
        accessible-action-default => { root.open(root.crumb.index); }
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.open(root.crumb.index);
                return accept;
            }
            return reject;
        }
        touch := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                focus.focus();
                root.open(root.crumb.index);
            }
        }
    }
}

/// The folders from the scan root down to the folder the treemap shows. A crumb opens its folder.
/// Its width never pushes on the window layout: crumbs that do not fit are cut with "…".
export component CrumbBar inherits Rectangle {
    in property <[Crumb]> crumbs;
    callback open(int);

    min-width: 0px;
    clip: true;
    HorizontalLayout {
        alignment: start;
        spacing: 2px;
        for c[i] in root.crumbs : HorizontalLayout {
            spacing: 2px;
            if i > 0 : Text {
                text: "›";
                vertical-alignment: center;
                color: Palette.foreground.transparentize(50%);
                accessible-role: none;
            }
            // The gap stands for folders that are not shown and opens nothing.
            if c.index < 0 : HorizontalLayout {
                padding-left: 6px;
                padding-right: 6px;
                Text {
                    text: c.text;
                    vertical-alignment: center;
                    color: Palette.foreground.transparentize(35%);
                    accessible-role: text;
                    accessible-label: "More folders";
                }
            }
            if c.index >= 0 : CrumbLink {
                crumb: c;
                current: i == root.crumbs.length - 1;
                open(n) => { root.open(n); }
            }
        }
    }
}

/// The treemap picture (drawn by the host on a worker) with the layers above it: the frame
/// and file labels, the map text, the selection outline and the focus ring.
export component TreemapView inherits Rectangle {
    /// The picture, in physical pixels, stretched over the whole view.
    in property <image> source;
    /// Labels of the frames, from the same layout as the picture.
    in property <[FrameLabel]> labels;
    /// Labels of the file tiles, from the same layout as the picture.
    in property <[FileLabel]> file-labels;
    /// Text over the map when it shows nothing, or "".
    in property <string> note;
    in property <bool> has-selection;
    in property <length> selection-x;
    in property <length> selection-y;
    in property <length> selection-width;
    in property <length> selection-height;

    /// A click at a point in logical pixels.
    callback clicked(float, float);
    /// A double-click at a point in logical pixels.
    callback double-clicked(float, float);
    /// Key press: "up", "down", "left", "right", "enter" or "backspace".
    callback key(string);
    /// The view changed size, in logical pixels.
    callback resized(float, float);

    /// Gives the map the keyboard focus.
    public function focus-map() {
        map-focus.focus();
    }

    // The image's pixel size must not feed back into the layout: each new image
    // would change the map size and start another layout.
    preferred-width: 0px;
    preferred-height: 0px;
    clip: true;
    changed width => { root.resized(self.width / 1px, self.height / 1px); }
    changed height => { root.resized(self.width / 1px, self.height / 1px); }
    Image {
        width: 100%;
        height: 100%;
        source: root.source;
        image-fit: fill;
    }
    // Above the picture, so no frame cuts a label off. The name keeps its full width when it
    // fits and is cut with "…" when it does not; the size takes what is left.
    for l in root.labels : Rectangle {
        x: l.x;
        y: l.y;
        width: l.width;
        height: l.height;
        label-name := Text {
            x: 3px;
            width: min(self.preferred-width, parent.width - 6px);
            height: parent.height;
            text: l.name;
            font-size: 11px;
            overflow: elide;
            vertical-alignment: center;
            color: Palette.foreground;
            accessible-role: none;
        }
        Text {
            x: label-name.x + label-name.width + 4px;
            width: max(0px, parent.width - self.x - 3px);
            height: parent.height;
            text: "(" + l.size + ")";
            font-size: 11px;
            overflow: elide;
            vertical-alignment: center;
            color: Palette.foreground.transparentize(40%);
            accessible-role: none;
        }
    }
    // File names on their tiles, in the tile's ink. The name comes first: the size follows it on
    // the same line only when both fit, or goes on a second line in a tile high enough for two.
    for f in root.file-labels : Rectangle {
        x: f.x;
        y: f.y;
        width: f.width;
        height: f.height;
        file-name := Text {
            x: 4px;
            y: 0px;
            width: min(self.preferred-width, parent.width - 8px);
            height: min(parent.height, 16px);
            text: f.name;
            font-size: 11px;
            overflow: elide;
            vertical-alignment: center;
            color: f.ink;
            accessible-role: none;
        }
        Text {
            x: f.two-lines ? 4px : file-name.x + file-name.width + 4px;
            y: f.two-lines ? 14px : 0px;
            width: f.two-lines ? parent.width - 8px : max(0px, parent.width - self.x - 4px);
            height: 16px;
            // The size shows whole (number and unit) or not at all: never cut to "29.1…".
            visible: self.preferred-width <= self.width;
            text: f.two-lines ? f.size : "(" + f.size + ")";
            font-size: 11px;
            overflow: elide;
            vertical-alignment: center;
            color: f.ink;
            accessible-role: none;
        }
    }
    if root.note != "" : Text {
        text: root.note;
        horizontal-alignment: center;
        vertical-alignment: center;
        wrap: word-wrap;
        color: Palette.foreground;
        accessible-role: text;
    }
    if root.has-selection : Rectangle {
        x: root.selection-x;
        y: root.selection-y;
        width: root.selection-width;
        height: root.selection-height;
        border-width: 2px;
        border-color: Palette.foreground;
    }
    map-focus := FocusScope {
        accessible-role: image;
        accessible-label: "Treemap";
        accessible-description: "Press an arrow key to move the selection. Press Enter to open the folder. Press Backspace to go up one folder.";
        key-pressed(event) => {
            if (Keys.name(event.text) == "" || event.text == " ") { return reject; }
            root.key(Keys.name(event.text));
            return accept;
        }
        TouchArea {
            mouse-cursor: pointer;
            clicked => {
                map-focus.focus();
                root.clicked(self.mouse-x / 1px, self.mouse-y / 1px);
            }
            double-clicked => { root.double-clicked(self.mouse-x / 1px, self.mouse-y / 1px); }
        }
    }
    Rectangle {
        border-width: map-focus.has-focus ? 2px : 0px;
        border-color: Palette.accent-background;
    }
}
