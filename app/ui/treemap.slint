import { Palette } from "std-widgets.slint";
import { Glass } from "theme.slint";

/// Names of the keys the host uses, shared by the file tree and the treemap.
export global Keys {
    /// Name of the key for the host, or "" for a key the host does not use.
    public pure function name(text: string) -> string {
        if (text == Key.UpArrow) { return "up"; }
        if (text == Key.DownArrow) { return "down"; }
        if (text == Key.LeftArrow) { return "left"; }
        if (text == Key.RightArrow) { return "right"; }
        if (text == Key.Return) { return "enter"; }
        if (text == " ") { return "space"; }
        if (text == Key.Backspace) { return "backspace"; }
        return "";
    }
}

/// The label of one frame, on its band, in logical pixels. Text is formatted by the host.
export struct FrameLabel {
    x: length,
    y: length,
    width: length,
    height: length,
    name: string,
    size: string,
}

/// The label of one file tile, on the tile, in logical pixels. Text is formatted by the host.
export struct FileLabel {
    x: length,
    y: length,
    width: length,
    height: length,
    name: string,
    size: string,
    /// Text colour that reads on the tile colour.
    ink: color,
    /// The size goes on a second line under the name.
    two-lines: bool,
}

/// The node under the pointer, in logical pixels. Set by the host only when that node changes.
export struct Hover {
    /// A node is under the pointer.
    visible: bool,
    x: length,
    y: length,
    width: length,
    height: length,
    /// A file tile: it lifts and glows in `color`. A folder frame gets a light highlight.
    lift: bool,
    /// The colour of the file type of the tile.
    color: color,
    /// The tile is big enough for its name: `label` is shown on the lifted tile.
    labelled: bool,
    /// The label of the tile, in the tile's own coordinates.
    label: FileLabel,
    /// The tooltip: the full path, then the size and the file type or the number of files.
    title: string,
    detail: string,
}

/// Where a moving picture is drawn over the map, in logical pixels, and how solid it is.
export struct ZoomFrame {
    x: length,
    y: length,
    width: length,
    height: length,
    opacity: float,
}

/// What sits on the map picture: a frame label, a file label, or an outline (selection or hover).
export enum LabelKind { frame, file, outline }

/// Where a label or an outline of the shown layout goes while the map has another size than that
/// layout (a resize before the new layout lands), in logical pixels. From the host.
export struct Placed {
    x: length,
    y: length,
    width: length,
    height: length,
    /// The box has room for the label.
    shown: bool,
    /// A file label has room for its size on a second line.
    two-lines: bool,
}

/// A move of a picture over the map: from one frame to another.
export struct ZoomMove {
    from: ZoomFrame,
    to: ZoomFrame,
}

/// One crumb above the treemap. Text is formatted by the host.
export struct Crumb {
    text: string,
    /// The node the crumb opens, or -1 for the gap crumb, which opens nothing.
    index: int,
}

/// One crumb: a link that opens its folder, by mouse, Enter or Space.
component CrumbLink inherits Rectangle {
    in property <Crumb> crumb;
    /// The folder the treemap shows: the last crumb.
    in property <bool> current;
    callback open(int);

    // A long name is cut with "…" when the crumbs do not fit; a short name is never cut.
    min-width: min(label.preferred-width, 64px) + 12px;
    max-width: 240px;
    border-radius: 4px;
    background: touch.has-hover ? Palette.alternate-background : transparent;
    border-width: focus.has-focus ? 2px : 0px;
    border-color: Palette.accent-background;
    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        label := Text {
            text: root.crumb.text;
            vertical-alignment: center;
            overflow: elide;
            font-weight: root.current ? 600 : 400;
            color: root.current ? Palette.foreground : Palette.foreground.transparentize(35%);
            accessible-role: none;
        }
    }
    focus := FocusScope {
        accessible-role: button;
        accessible-label: "Open \{root.crumb.text}";
        accessible-action-default => { root.open(root.crumb.index); }
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.open(root.crumb.index);
                return accept;
            }
            return reject;
        }
        touch := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                focus.focus();
                root.open(root.crumb.index);
            }
        }
    }
}

/// The folders from the scan root down to the folder the treemap shows. A crumb opens its folder.
/// Its width never pushes on the window layout: crumbs that do not fit are cut with "…".
export component CrumbBar inherits Rectangle {
    in property <[Crumb]> crumbs;
    callback open(int);

    min-width: 0px;
    clip: true;
    HorizontalLayout {
        alignment: start;
        spacing: 2px;
        for c[i] in root.crumbs : HorizontalLayout {
            spacing: 2px;
            if i > 0 : Text {
                text: "›";
                vertical-alignment: center;
                color: Palette.foreground.transparentize(50%);
                accessible-role: none;
            }
            // The gap stands for folders that are not shown and opens nothing.
            if c.index < 0 : HorizontalLayout {
                padding-left: 6px;
                padding-right: 6px;
                Text {
                    text: c.text;
                    vertical-alignment: center;
                    color: Palette.foreground.transparentize(35%);
                    accessible-role: text;
                    accessible-label: "More folders";
                }
            }
            if c.index >= 0 : CrumbLink {
                crumb: c;
                current: i == root.crumbs.length - 1;
                open(n) => { root.open(n); }
            }
        }
    }
}

/// The name and size of one file tile, in the tile's ink, over the whole tile. The name comes first:
/// the size follows it on the same line only when both fit, or goes on a second line in a tile high
/// enough for two.
component FileLabelView inherits Rectangle {
    in property <FileLabel> label;
    file-name := Text {
        x: 4px;
        y: 0px;
        width: min(self.preferred-width, root.width - 8px);
        height: min(root.height, 16px);
        text: root.label.name;
        font-size: 11px;
        overflow: elide;
        vertical-alignment: center;
        color: root.label.ink;
        accessible-role: none;
    }
    Text {
        x: root.label.two-lines ? 4px : file-name.x + file-name.width + 4px;
        y: root.label.two-lines ? 14px : 0px;
        width: root.label.two-lines ? root.width - 8px : max(0px, root.width - self.x - 4px);
        height: 16px;
        // The size shows whole (number and unit) or not at all: never cut to "29.1…".
        visible: self.preferred-width <= self.width;
        text: root.label.two-lines ? root.label.size : "(" + root.label.size + ")";
        font-size: 11px;
        overflow: elide;
        vertical-alignment: center;
        color: root.label.ink;
        accessible-role: none;
    }
}

/// The treemap picture (drawn by the host on a worker) with the layers above it: the frame
/// and file labels, the map text, the selection outline, the hover and the focus ring.
export component TreemapView inherits Rectangle {
    /// The picture, in physical pixels, stretched over the whole view.
    in property <image> source;
    /// Labels of the frames, from the same layout as the picture.
    in property <[FrameLabel]> labels;
    /// Labels of the file tiles, from the same layout as the picture.
    in property <[FileLabel]> file-labels;
    /// Text over the map when it shows nothing, or "".
    in property <string> note;
    /// The selected node for a screen reader: its name and size.
    in property <string> value;
    in property <bool> has-selection;
    in property <length> selection-x;
    in property <length> selection-y;
    in property <length> selection-width;
    in property <length> selection-height;
    /// The node under the pointer, from the host.
    in property <Hover> hover;
    /// The renderer draws drop shadows: the hovered tile glows. Without them it gets a bright border.
    in property <bool> glow: true;
    /// The tooltip of the hovered node shows, near the map point (tip-x, tip-y).
    in property <bool> tip-visible;
    in property <length> tip-x;
    in property <length> tip-y;
    /// The picture that moves in place of the map picture: the old picture that zooms in, or the new
    /// one that zooms out.
    in property <image> zoom-image;
    /// Where the moving picture starts and ends, and how solid it is there.
    in property <ZoomMove> zoom;
    /// The moving picture shows. The labels, the outline, the hover and the tooltip do not.
    in property <bool> zoom-shown;
    /// The move runs: `zoom-t` goes from 0 to 1 in `zoom-duration` after `start-zoom()`.
    in property <bool> zoom-running;
    in property <duration> zoom-duration: 180ms;
    /// Time of the move, 0 to 1. Reads the animation clock only while the move runs, so a move
    /// that ended draws no more frames.
    out property <float> zoom-t: root.zoom-running ? clamp((animation-tick() - root.zoom-start) / root.zoom-duration, 0, 1) : 1;
    private property <duration> zoom-start;

    /// The pointer moved over the map, with no button down, to a point in logical pixels.
    callback hovered(float, float);
    /// The pointer left the map.
    callback left();
    /// A button press or a scroll on the map: the tooltip hides.
    /// A button went down (false) or the wheel turned (true): the tooltip hides until the pointer moves.
    callback hide-tip(bool);
    /// Where the tooltip starts on one axis: (pointer, tooltip size, map size, gap after the pointer).
    pure callback tip-position(float, float, float, float) -> float;
    /// The tooltip path with a break point after each folder, so it wraps between names.
    pure callback break-points(string) -> string;
    /// A click at a point in logical pixels.
    callback clicked(float, float);
    /// A double-click at a point in logical pixels.
    callback double-clicked(float, float);
    /// Key press: "up", "down", "left", "right", "enter" or "backspace".
    callback key(string);
    /// The view changed size, in logical pixels.
    callback resized(float, float);
    /// Where the moving picture is at time t (0 to 1) of move `zoom`.
    pure callback zoom-frame(ZoomMove, float) -> ZoomFrame;

    /// The move starts now: `zoom-t` is 0.
    public function start-zoom() {
        root.zoom-start = animation-tick();
    }

    /// Gives the map the keyboard focus.
    public function focus-map() {
        map-focus.focus();
    }

    // The image's pixel size must not feed back into the layout: each new image
    // would change the map size and start another layout.
    preferred-width: 0px;
    preferred-height: 0px;
    changed width => { root.resized(self.width / 1px, self.height / 1px); }
    changed height => { root.resized(self.width / 1px, self.height / 1px); }
    // The picture and its labels, cut at the map edge. The layers after this one are not cut, so a
    // glow can go past the map edge (a layer inside a clipped parent is cut at its edge: P1 spike).
    Rectangle {
        width: 100%;
        height: 100%;
        clip: true;
        Image {
            // A moving picture takes its place: the pictures are glass and would mix.
            visible: !root.zoom-shown;
            width: 100%;
            height: 100%;
            source: root.source;
            image-fit: fill;
            // The map focus scope below is the treemap for a screen reader.
            accessible-role: none;
        }
        // The moving picture, over the picture and cut at the map edge like it.
        if root.zoom-shown : Image {
            property <ZoomFrame> at: root.zoom-frame(root.zoom, root.zoom-t);
            x: self.at.x;
            y: self.at.y;
            width: self.at.width;
            height: self.at.height;
            opacity: self.at.opacity;
            source: root.zoom-image;
            image-fit: fill;
            accessible-role: none;
        }
        // Above the picture, so no frame cuts a label off. The name keeps its full width when it
        // fits and is cut with "…" when it does not; the size takes what is left.
        for l in root.labels : Rectangle {
            visible: !root.zoom-shown;
            x: l.x;
            y: l.y;
            width: l.width;
            height: l.height;
            label-name := Text {
                x: 3px;
                width: min(self.preferred-width, parent.width - 6px);
                height: parent.height;
                text: l.name;
                font-size: 11px;
                overflow: elide;
                vertical-alignment: center;
                color: Palette.foreground;
                accessible-role: none;
            }
            Text {
                x: label-name.x + label-name.width + 4px;
                width: max(0px, parent.width - self.x - 3px);
                height: parent.height;
                text: "(" + l.size + ")";
                font-size: 11px;
                overflow: elide;
                vertical-alignment: center;
                color: Palette.foreground.transparentize(40%);
                accessible-role: none;
            }
        }
        // File names on their tiles, in the tile's ink.
        for f in root.file-labels : FileLabelView {
            visible: !root.zoom-shown;
            x: f.x;
            y: f.y;
            width: f.width;
            height: f.height;
            label: f;
        }
        if root.note != "" : Text {
            text: root.note;
            horizontal-alignment: center;
            vertical-alignment: center;
            wrap: word-wrap;
            color: Palette.foreground;
            accessible-role: text;
        }
    }
    // The selection outline, above the frames. It slides to the next selected node.
    if root.has-selection && !root.zoom-shown : Rectangle {
        x: root.selection-x;
        y: root.selection-y;
        width: root.selection-width;
        height: root.selection-height;
        border-width: 2px;
        border-color: Palette.foreground;
        animate x, y, width, height { duration: 120ms; easing: ease-out; }
    }
    // The hover, above everything in the map. A folder frame gets a light highlight, with no lift.
    if root.hover.visible && !root.hover.lift && !root.zoom-shown : Rectangle {
        x: root.hover.x;
        y: root.hover.y;
        width: root.hover.width;
        height: root.hover.height;
        border-radius: min(4px, min(self.width, self.height) / 2);
        background: Palette.foreground.transparentize(93%);
        border-width: 1px;
        border-color: Palette.foreground.transparentize(40%);
    }
    // A file tile lifts 2 px and glows in its file-type colour. FemtoVG ignores drop-shadow-spread,
    // so a clear rect 3 px bigger on each side carries the shadow to give the glow more reach (P1
    // spike). Without shadows (software renderer) the tile gets a 2 px bright border instead.
    if root.hover.visible && root.hover.lift && !root.zoom-shown : Rectangle {
        x: root.hover.x - 3px;
        y: root.hover.y - 2px - 3px;
        width: root.hover.width + 6px;
        height: root.hover.height + 6px;
        border-radius: min(4px, min(root.hover.width, root.hover.height) / 2) + 3px;
        drop-shadow-blur: root.glow ? 14px : 0px;
        drop-shadow-color: root.glow ? root.hover.color : transparent;
        Rectangle {
            x: 3px;
            y: 3px;
            width: root.hover.width;
            height: root.hover.height;
            border-radius: min(4px, min(self.width, self.height) / 2);
            background: @linear-gradient(180deg, root.hover.color.brighter(45%) 0%, root.hover.color.brighter(15%) 55%);
            border-width: root.glow ? 1px : 2px;
            border-color: root.glow ? #ffffff99 : #ffffffd9;
            // The lifted tile covers the label on the picture, so it shows the label itself.
            if root.hover.labelled : FileLabelView {
                x: 0px;
                y: 0px;
                width: 100%;
                height: 100%;
                label: root.hover.label;
            }
        }
    }
    // The tooltip of the hovered node, above the hover and inside the map: after the pointer when it
    // fits, else before it (the host's tip-position). A long path wraps after a folder (the host's
    // break-points); a name longer than the line wraps inside it.
    if root.tip-visible && root.hover.visible && !root.zoom-shown : Rectangle {
        width: min(tip-lines.preferred-width, min(root.width, 520px));
        height: tip-lines.preferred-height;
        x: root.tip-position(root.tip-x / 1px, self.width / 1px, root.width / 1px, 16) * 1px;
        y: root.tip-position(root.tip-y / 1px, self.height / 1px, root.height / 1px, 20) * 1px;
        border-radius: 6px;
        background: Palette.background;
        border-width: 1px;
        border-color: Glass.border;
        drop-shadow-blur: 8px;
        drop-shadow-color: #00000066;
        tip-lines := VerticalLayout {
            padding-left: 8px;
            padding-right: 8px;
            padding-top: 5px;
            padding-bottom: 6px;
            spacing: 2px;
            Text {
                text: root.break-points(root.hover.title);
                accessible-role: none;
                font-size: 12px;
                wrap: word-wrap;
                color: Palette.foreground;
            }
            Text {
                text: root.hover.detail;
                accessible-role: none;
                font-size: 12px;
                wrap: word-wrap;
                color: Palette.foreground.transparentize(30%);
            }
        }
    }
    map-focus := FocusScope {
        accessible-role: image;
        accessible-label: "Treemap";
        accessible-value: root.value;
        accessible-description: "Press an arrow key to move the selection. Press Enter to open the folder. Press Backspace to go up one folder.";
        key-pressed(event) => {
            if (Keys.name(event.text) == "" || event.text == " ") { return reject; }
            root.key(Keys.name(event.text));
            return accept;
        }
        TouchArea {
            mouse-cursor: pointer;
            // `moved` only fires while a button is down; a pointer event of kind move fires without.
            pointer-event(event) => {
                if (event.kind == PointerEventKind.move) {
                    root.hovered(self.mouse-x / 1px, self.mouse-y / 1px);
                } else if (event.kind == PointerEventKind.down) {
                    root.hide-tip(false);
                }
            }
            scroll-event(event) => {
                root.hide-tip(true);
                return reject;
            }
            changed has-hover => {
                if (!self.has-hover) {
                    root.left();
                }
            }
            clicked => {
                map-focus.focus();
                root.clicked(self.mouse-x / 1px, self.mouse-y / 1px);
            }
            double-clicked => { root.double-clicked(self.mouse-x / 1px, self.mouse-y / 1px); }
        }
    }
    Rectangle {
        border-width: map-focus.has-focus ? 2px : 0px;
        border-color: Palette.accent-background;
    }
}
