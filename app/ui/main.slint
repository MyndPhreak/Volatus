import { Button, ProgressIndicator, Palette, ListView } from "std-widgets.slint";
import { Crumb, CrumbBar, FileLabel, FrameLabel, Hover, Keys, LabelKind, Placed, TreemapView, ZoomFrame, ZoomMove } from "treemap.slint";
import { Glass, GlassPanel } from "theme.slint";
import { DriveButton, StartScreen } from "start.slint";
import { SettingsButton, SettingsFlyout } from "settings.slint";
export { Crumb, FileLabel, FrameLabel, Hover, DriveButton, LabelKind, Placed, ZoomFrame, ZoomMove }
// The host writes `Palette.color-scheme` to apply the theme setting.
export { Palette }

/// One visible line of the file tree. Text is formatted by the host.
export struct TreeRow {
    name: string,
    size: string,
    percent: string,
    files: string,
    depth: int,
    expanded: bool,
    has-children: bool,
    /// What a screen reader says for the row: name, size, percent and files.
    spoken: string,
}

/// One file type in the footer: its share of the scan and its tile colour. Text is formatted by the host.
export struct TypeChip {
    label: string,
    percent: string,
    share: float,
    color: color,
    /// What a screen reader says for the chip: label, percent and size.
    spoken: string,
}

/// Sort column ids shared with the host: 0 name, 1 size, 2 percent of parent, 3 files.
component HeaderCell inherits Rectangle {
    in property <string> text;
    /// The column name for screen readers; the shown text can be shorter.
    in property <string> name: root.text;
    in property <bool> active;
    in property <bool> descending;
    in property <bool> right-aligned: true;
    callback clicked();
    height: 28px;
    background: touch.has-hover ? Palette.alternate-background : transparent;
    border-width: focus.has-focus ? 2px : 0px;
    border-color: Palette.accent-background;
    focus := FocusScope {
        accessible-role: button;
        accessible-label: "Sort by \{root.name}";
        accessible-action-default => { root.clicked(); }
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.clicked();
                return accept;
            }
            return reject;
        }
        Text {
            x: 6px;
            width: parent.width - 12px;
            height: parent.height;
            vertical-alignment: center;
            horizontal-alignment: root.right-aligned ? right : left;
            font-weight: 600;
            text: root.text + (root.active ? (root.descending ? " ▼" : " ▲") : "");
            overflow: elide;
            accessible-role: none;
        }
        touch := TouchArea { clicked => { root.clicked(); focus.focus(); } }
    }
}

/// A number in a tree row, right-aligned with the column header above it.
component NumberCell inherits Rectangle {
    in property <string> text;
    in property <color> text-color;
    Text {
        x: 0px;
        width: parent.width - 6px;
        height: parent.height;
        text: root.text;
        horizontal-alignment: right;
        vertical-alignment: center;
        overflow: elide;
        color: root.text-color;
        accessible-role: none;
    }
}

export component MainWindow inherits Window {
    title: "Volatus";
    icon: @image-url("../assets/volatus.png");
    // The window must start transparent so the Mica backdrop shows through (set at window creation).
    // If Mica is not available, the host sets `mica` to false and the Fluent palette fills the window.
    in property <bool> mica: true;
    /// The window is dark (the host sets `Palette.color-scheme` from the theme setting). The host
    /// draws the treemap for it.
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;
    changed dark => { root.theme-changed(); }
    background: root.mica ? transparent : Palette.background;
    preferred-width: 1100px;
    preferred-height: 700px;
    min-width: 960px;
    min-height: 600px;

    in property <bool> scanning;
    in property <string> banner;
    // True while the folder dialog is open.
    in property <bool> browsing;
    in property <bool> banner-is-error;

    // Start screen
    /// The start screen is shown: nothing is scanning and no result is shown.
    in property <bool> start-screen: true;
    /// One button per ready drive.
    in property <[DriveButton]> drive-buttons;
    /// The host is still looking for drives.
    in property <bool> drives-loading: true;
    /// One note under the drive list, or "".
    in property <string> admin-note;
    /// A scan is finished: "New scan" is offered.
    in property <bool> show-new-scan;
    /// The shown scan changed on disk after a menu action: the top bar offers Rescan.
    in property <bool> outdated;
    /// The drive or folder of the shown scan, as typed, for the top bar.
    in property <string> scan-title;

    // File tree
    in property <[TreeRow]> rows;
    in property <int> selected-row: -1;
    in property <int> sort-key: 1;
    in property <bool> sort-descending: true;

    // Treemap
    in property <image> treemap;
    /// The folders from the scan root down to the folder the treemap shows.
    in property <[Crumb]> crumbs;
    in property <bool> has-selection;
    in property <length> selection-x;
    in property <length> selection-y;
    in property <length> selection-width;
    in property <length> selection-height;
    /// Text over the treemap when it shows nothing, or "".
    in property <string> map-note;
    /// The selected node for a screen reader: its name and size.
    in property <string> map-value;
    /// Labels of the treemap frames.
    in property <[FrameLabel]> labels;
    /// Labels of the treemap file tiles.
    in property <[FileLabel]> file-labels;
    /// The treemap size the shown picture and labels were made for, in logical pixels.
    in property <length> layout-width;
    in property <length> layout-height;
    /// The treemap node under the pointer.
    in property <Hover> hover;
    /// The renderer draws drop shadows (false: the software renderer).
    in property <bool> glow: true;
    /// The tooltip of the hovered node shows, near the treemap point (tip-x, tip-y).
    in property <bool> tip-visible;
    in property <length> tip-x;
    in property <length> tip-y;
    /// The picture that moves over the treemap, its move, and whether it shows and runs.
    in property <image> zoom-image;
    in property <ZoomMove> zoom;
    in property <bool> zoom-shown;
    in property <bool> zoom-running;
    in property <duration> zoom-duration: 180ms;
    /// Time of the move, 0 to 1.
    out property <float> zoom-t: map.zoom-t;

    // File-type footer
    /// The biggest file types of the scan, then "Other".
    in property <[TypeChip]> type-chips;
    /// The host is still counting the file types of the shown scan.
    in property <bool> types-counting;

    // Elevation
    in property <bool> show-elevate;
    in property <string> elevate-note;

    // Settings
    /// The settings flyout is open. The gear and Esc change it.
    in-out property <bool> settings-open;
    /// The chosen theme: 0 Follow Windows, 1 Light, 2 Dark.
    in property <int> theme-choice;
    /// The chosen unit of sizes: 0 Dynamic, 1 Byte, 2 KB, 3 MB, 4 GB, 5 TB.
    in property <int> unit-choice;
    /// Why the settings are not saved, or "".
    in property <string> settings-error;
    /// A theme was chosen in the flyout. The argument is its index, as in `theme-choice`.
    callback theme-chosen(int);
    /// A unit was chosen in the flyout. The argument is its index, as in `unit-choice`.
    callback unit-chosen(int);

    /// A drive button was used. The argument is the drive root, such as "C:\".
    callback scan-drive(string);
    callback choose-folder();
    callback new-scan();
    /// Scans the shown scan's folder again, with the same options.
    callback rescan();
    callback cancel();
    callback tree-select(int);
    callback tree-toggle(int);
    callback tree-sort(int);
    callback treemap-click(float, float);
    callback treemap-open(float, float);
    /// A right-click on the treemap: (map x, map y, window x, window y) in logical pixels.
    callback treemap-menu(float, float, float, float);
    /// A right-click on tree row i: (i, window x, window y) in logical pixels.
    callback tree-menu(int, float, float);
    /// A right-click on a crumb: (its node, window x, window y) in logical pixels.
    callback crumb-menu(int, float, float);
    /// The Menu key or Shift+F10 on a crumb: (its node, its box in the window) in logical pixels.
    callback crumb-menu-key(int, float, float, float, float);
    /// The Menu key or Shift+F10 in the tree or the treemap: the box of the selected item in the
    /// window, in logical pixels.
    callback menu-key(float, float, float, float);
    /// A crumb was used. The argument is the crumb index: the node to open.
    callback crumb-open(int);
    /// Key press in the file tree: "up", "down", "left", "right", "enter" or "space".
    callback tree-key(string);
    /// Key press in the treemap: "up", "down", "left", "right", "enter" or "backspace".
    callback map-key(string);
    callback treemap-resized(float, float);
    /// The pointer moved over the treemap, with no button down, to a point in logical pixels.
    callback treemap-hover(float, float);
    /// The pointer left the treemap.
    callback treemap-leave();
    /// A button press or a scroll on the treemap: the tooltip hides.
    callback treemap-hide-tip(bool);
    /// Where the tooltip starts on one axis: (pointer, tooltip size, map size, gap after the pointer).
    pure callback tip-position(float, float, float, float) -> float;
    /// The tooltip path with a break point after each folder.
    pure callback tip-break-points(string) -> string;
    /// Where the moving picture is at time t (0 to 1) of a move.
    pure callback zoom-frame(ZoomMove, float) -> ZoomFrame;
    /// Where a label or outline of the shown layout goes on the stretched treemap picture.
    pure callback place-label(Placed, LabelKind, length, length, length, length) -> Placed;
    callback restart-admin();
    /// The system theme changed between light and dark.
    callback theme-changed();

    // Widths of the number columns of the file tree, and the room kept free for its scroll bar
    // (the Fluent scroll bar is 14 px, drawn over the list).
    private property <length> size-column: 76px;
    private property <length> percent-column: 60px;
    private property <length> files-column: 72px;
    private property <length> scrollbar-room: 16px;

    /// The move of the picture over the treemap starts now.
    public function start-zoom() {
        map.start-zoom();
    }

    /// Scrolls the file tree so row `i` is inside the view.
    public function show-row(i: int) {
        if (i * 24px < -list.content-y) {
            list.content-y = -i * 24px;
        } else if ((i + 1) * 24px > -list.content-y + list.visible-height) {
            list.content-y = -((i + 1) * 24px - list.visible-height);
        }
    }

    // Esc closes the flyout from anywhere: this scope sees each key before the focused element
    // and takes only Esc while the flyout is open. It never takes the focus itself.
    FocusScope {
        focus-on-click: false;
        focus-on-tab-navigation: false;
        capture-key-pressed(event) => {
            if (root.settings-open && event.text == Key.Escape) {
                root.settings-open = false;
                gear.take-focus();
                return accept;
            }
            return reject;
        }

        if root.start-screen : StartScreen {
            width: 100%;
            height: 100%;
            drives: root.drive-buttons;
            loading: root.drives-loading;
            admin-note: root.admin-note;
            message: root.banner;
            message-is-error: root.banner-is-error;
            browsing: root.browsing;
            restart-note: root.elevate-note;
            scan-drive(drive) => { root.scan-drive(drive); }
            choose-folder => { root.choose-folder(); }
            restart-admin => { root.restart-admin(); }
        }
        // The results stay in the tree while the start screen shows, so the file tree keeps its scroll
        // function; hidden, they take no input.
        VerticalLayout {
            visible: !root.start-screen;
            width: 100%;
            height: 100%;
            padding: Glass.margin;
            spacing: Glass.gap;
            // Top bar: the buttons, then the scanned drive or folder and the scan summary. Always
            // 52 px high, and the progress line under it is always 3 px, so the map keeps its size
            // when a scan ends (a size change would lay the map out a second time).
            HorizontalLayout {
                height: 52px;
                spacing: Glass.gap;
                // The buttons keep their own height, centred in the bar.
                VerticalLayout {
                    alignment: center;
                    HorizontalLayout {
                        spacing: Glass.gap;
                        if root.scanning : Button {
                            text: "Cancel";
                            clicked => { root.cancel(); }
                        }
                        if root.show-new-scan : Button {
                            text: "New scan";
                            primary: true;
                            clicked => { root.new-scan(); }
                        }
                        if root.show-elevate : Button {
                            text: "Restart as administrator";
                            enabled: !root.scanning;
                            clicked => { root.restart-admin(); }
                        }
                        if root.outdated : Text {
                            text: "Files changed after this scan.";
                            vertical-alignment: center;
                            color: Glass.dim;
                            accessible-role: text;
                        }
                        if root.outdated : Button {
                            text: "Rescan";
                            clicked => { root.rescan(); }
                        }
                    }
                }
                // Takes the free width, so the buttons keep their own width.
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    padding-left: 4px;
                    Text {
                        text: root.scan-title;
                        font-weight: 600;
                        overflow: elide;
                        accessible-role: text;
                    }
                    // Two lines at most, so the timing line still shows in a narrow window.
                    Text {
                        text: root.banner;
                        font-size: 12px;
                        max-height: 32px;
                        wrap: word-wrap;
                        overflow: elide;
                        color: root.banner-is-error ? #d13438 : Glass.dim;
                        accessible-role: text;
                    }
                }
                // The gear sits over this room, so the summary text never goes under it.
                Rectangle { width: 40px; }
            }
            Rectangle {
                height: 3px;
                if root.scanning : ProgressIndicator {
                    width: 100%;
                    height: 100%;
                    indeterminate: true;
                    accessible-label: "Scan progress";
                }
            }
            if root.elevate-note != "" : Text {
                text: root.elevate-note;
                wrap: word-wrap;
                color: #d13438;
                accessible-role: text;
            }

            HorizontalLayout {
                spacing: Glass.gap;
                // Sidebar: the file tree. Each pane has `preferred-width: 0px`, so the free space is
                // shared 27 : 73 (a layout cannot take a width from the window width itself); the
                // sidebar never goes under 340 px.
                GlassPanel {
                    horizontal-stretch: 27;
                    preferred-width: 0px;
                    min-width: 340px;
                    VerticalLayout {
                        padding: 4px;
                        // The right padding keeps the last header over its column: the rows leave
                        // room for the scroll bar, which is drawn over the list.
                        HorizontalLayout {
                            padding-left: 2px;
                            padding-right: 2px + root.scrollbar-room;
                            HeaderCell {
                                horizontal-stretch: 1;
                                text: "Name";
                                right-aligned: false;
                                active: root.sort-key == 0;
                                descending: root.sort-descending;
                                clicked => { root.tree-sort(0); }
                            }
                            HeaderCell {
                                width: root.size-column;
                                text: "Size";
                                active: root.sort-key == 1;
                                descending: root.sort-descending;
                                clicked => { root.tree-sort(1); }
                            }
                            HeaderCell {
                                width: root.percent-column;
                                text: "%";
                                name: "percent of parent";
                                active: root.sort-key == 2;
                                descending: root.sort-descending;
                                clicked => { root.tree-sort(2); }
                            }
                            HeaderCell {
                                width: root.files-column;
                                text: "Files";
                                active: root.sort-key == 3;
                                descending: root.sort-descending;
                                clicked => { root.tree-sort(3); }
                            }
                        }
                        tree-focus := FocusScope {
                            vertical-stretch: 1;
                            accessible-role: tree;
                            accessible-label: "File tree";
                            accessible-description: "Press the Menu key for the context menu.";
                            accessible-value: root.selected-row >= 0 ? root.rows[root.selected-row].name : "";
                            key-pressed(event) => {
                                if (Keys.menu(event)) {
                                    // The selected row, kept inside the list when it is scrolled away.
                                    root.menu-key(list.absolute-position.x / 1px, (list.absolute-position.y + clamp(list.content-y + root.selected-row * 24px, 0px, max(0px, list.height - 24px))) / 1px, list.width / 1px, 24);
                                    return accept;
                                }
                                if (Keys.name(event.text) == "") { return reject; }
                                root.tree-key(Keys.name(event.text));
                                return accept;
                            }
                            list := ListView {
                                accessible-label: "Rows of the file tree";
                                // Inside the focus ring, so the ring does not cover the last column.
                                x: 2px;
                                y: 2px;
                                width: parent.width - 4px;
                                height: parent.height - 4px;
                                for row[i] in root.rows : Rectangle {
                                    height: 24px;
                                    border-radius: 4px;
                                    accessible-role: list-item;
                                    accessible-label: row.spoken;
                                    accessible-item-selected: i == root.selected-row;
                                    accessible-item-index: i;
                                    background: i == root.selected-row ? Palette.selection-background : (row-touch.has-hover ? Palette.alternate-background : transparent);
                                    row-touch := TouchArea {
                                        clicked => { root.tree-select(i); tree-focus.focus(); }
                                        // `clicked` does not fire for the right button.
                                        pointer-event(event) => {
                                            if (event.kind == PointerEventKind.up && event.button == PointerEventButton.right) {
                                                tree-focus.focus();
                                                root.tree-menu(i, (self.absolute-position.x + self.mouse-x) / 1px, (self.absolute-position.y + self.mouse-y) / 1px);
                                            }
                                        }
                                    }
                                    HorizontalLayout {
                                        padding-right: root.scrollbar-room;
                                        Rectangle {
                                            horizontal-stretch: 1;
                                            HorizontalLayout {
                                                padding-left: 4px + row.depth * 16px;
                                                spacing: 4px;
                                                Rectangle {
                                                    width: 16px;
                                                    if row.has-children : Text {
                                                        text: row.expanded ? "-" : "+";
                                                        vertical-alignment: center;
                                                        horizontal-alignment: center;
                                                        accessible-role: button;
                                                        accessible-label: row.expanded ? "Collapse \{row.name}" : "Expand \{row.name}";
                                                    }
                                                    if row.has-children : TouchArea {
                                                        clicked => { root.tree-toggle(i); tree-focus.focus(); }
                                                        // Above the row's TouchArea: a right-click here opens the row's menu too.
                                                        pointer-event(event) => {
                                                            if (event.kind == PointerEventKind.up && event.button == PointerEventButton.right) {
                                                                tree-focus.focus();
                                                                root.tree-menu(i, (self.absolute-position.x + self.mouse-x) / 1px, (self.absolute-position.y + self.mouse-y) / 1px);
                                                            }
                                                        }
                                                    }
                                                }
                                                Text {
                                                    text: row.name;
                                                    vertical-alignment: center;
                                                    overflow: elide;
                                                    accessible-role: none;
                                                    color: i == root.selected-row ? Palette.selection-foreground : Palette.foreground;
                                                }
                                            }
                                        }
                                        NumberCell { width: root.size-column; text: row.size; text-color: i == root.selected-row ? Palette.selection-foreground : Palette.foreground; }
                                        NumberCell { width: root.percent-column; text: row.percent; text-color: i == root.selected-row ? Palette.selection-foreground : Palette.foreground; }
                                        NumberCell { width: root.files-column; text: row.files; text-color: i == root.selected-row ? Palette.selection-foreground : Palette.foreground; }
                                    }
                                }
                            }
                            Rectangle {
                                border-radius: 4px;
                                border-width: tree-focus.has-focus ? 2px : 0px;
                                border-color: Palette.accent-background;
                            }
                        }
                    }
                }
                // Main area: the crumbs, then the treemap.
                GlassPanel {
                    horizontal-stretch: 73;
                    preferred-width: 0px;
                    VerticalLayout {
                        padding: 4px;
                        spacing: 4px;
                        CrumbBar {
                            height: 28px;
                            crumbs: root.crumbs;
                            // The crumbs are rebuilt for the opened folder, so the focus goes to the
                            // map, which shows that folder.
                            open(i) => {
                                root.crumb-open(i);
                                map.focus-map();
                            }
                            menu(i, x, y) => { root.crumb-menu(i, x, y); }
                            menu-key(i, x, y, w, h) => { root.crumb-menu-key(i, x, y, w, h); }
                        }
                        map := TreemapView {
                            vertical-stretch: 1;
                            source: root.treemap;
                            note: root.map-note;
                            value: root.map-value;
                            labels: root.labels;
                            file-labels: root.file-labels;
                            layout-width: root.layout-width;
                            layout-height: root.layout-height;
                            has-selection: root.has-selection;
                            selection-x: root.selection-x;
                            selection-y: root.selection-y;
                            selection-width: root.selection-width;
                            selection-height: root.selection-height;
                            hover: root.hover;
                            glow: root.glow;
                            tip-visible: root.tip-visible;
                            tip-x: root.tip-x;
                            tip-y: root.tip-y;
                            zoom-image: root.zoom-image;
                            zoom: root.zoom;
                            zoom-shown: root.zoom-shown;
                            zoom-running: root.zoom-running;
                            zoom-duration: root.zoom-duration;
                            hovered(x, y) => { root.treemap-hover(x, y); }
                            left => { root.treemap-leave(); }
                            hide-tip(scrolled) => { root.treemap-hide-tip(scrolled); }
                            tip-position(pointer, size, extent, gap) => { return root.tip-position(pointer, size, extent, gap); }
                            break-points(path) => { return root.tip-break-points(path); }
                            zoom-frame(m, t) => { return root.zoom-frame(m, t); }
                            place(p, kind, from-w, from-h, to-w, to-h) => { return root.place-label(p, kind, from-w, from-h, to-w, to-h); }
                            clicked(x, y) => { root.treemap-click(x, y); }
                            double-clicked(x, y) => { root.treemap-open(x, y); }
                            menu(x, y, wx, wy) => { root.treemap-menu(x, y, wx, wy); }
                            menu-key(x, y, w, h) => { root.menu-key(x, y, w, h); }
                            key(k) => { root.map-key(k); }
                            resized(w, h) => { root.treemap-resized(w, h); }
                        }
                    }
                }
            }

            // File-type footer, the full width: a strip with one part per type and the chips under
            // it, in the tile colours. Always there and always the same height, so the map keeps its
            // size when a scan is shown or the chips arrive (a size change would lay the map out a
            // second time).
            GlassPanel {
                height: 48px;
                VerticalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    padding-top: 8px;
                    padding-bottom: 8px;
                    spacing: 6px;
                    if root.types-counting || (root.type-chips.length == 0 && root.rows.length > 0) : Text {
                        height: 32px;
                        // The tree has rows only while a scan is shown; with no rows there is no text.
                        text: root.types-counting ? "Counting file types." : "No file sizes to show.";
                        vertical-alignment: center;
                        color: Glass.dim;
                        accessible-role: text;
                    }
                    if !root.types-counting && root.type-chips.length > 0 : Rectangle {
                        height: 10px;
                        border-radius: 3px;
                        clip: true;
                        HorizontalLayout {
                            spacing: 1px;
                            for chip in root.type-chips : Rectangle {
                                horizontal-stretch: chip.share;
                                min-width: 0px;
                                preferred-width: 0px;
                                background: chip.color;
                            }
                        }
                    }
                    if !root.types-counting && root.type-chips.length > 0 : HorizontalLayout {
                        height: 16px;
                        spacing: 12px;
                        alignment: start;
                        for chip in root.type-chips : HorizontalLayout {
                            spacing: 4px;
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 9px;
                                    height: 9px;
                                    border-radius: 2px;
                                    background: chip.color;
                                }
                            }
                            Text {
                                text: chip.label + " " + chip.percent;
                                vertical-alignment: center;
                                overflow: elide;
                                color: Palette.foreground.transparentize(20%);
                                accessible-role: text;
                                accessible-label: chip.spoken;
                            }
                        }
                    }
                }
            }
        }

        // The flyout, over the right edge under the top bar, and the gear, above both screens.
        if root.settings-open : SettingsFlyout {
            x: root.width - Glass.margin - self.width;
            y: Glass.margin + 52px + Glass.gap;
            theme-choice: root.theme-choice;
            unit-choice: root.unit-choice;
            error: root.settings-error;
            theme-chosen(i) => { root.theme-chosen(i); }
            unit-chosen(i) => { root.unit-chosen(i); }
            close => {
                root.settings-open = false;
                gear.take-focus();
            }
        }
        // Centred in the 40 px room at the right end of the top bar. On the start screen it stays
        // right of the scroll bar and of the centred drive list.
        gear := SettingsButton {
            x: root.width - Glass.margin - 36px;
            y: Glass.margin + (52px - self.height) / 2;
            open: root.settings-open;
            clicked => { root.settings-open = !root.settings-open; }
        }
    }
}
