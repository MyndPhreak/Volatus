import { Button, VerticalBox, HorizontalBox, ProgressIndicator, Palette, ListView } from "std-widgets.slint";
import { FrameLabel, Keys, TreemapView } from "treemap.slint";
import { DriveButton, StartScreen } from "start.slint";
export { FrameLabel, DriveButton }

/// One visible line of the file tree. Text is formatted by the host.
export struct TreeRow {
    name: string,
    size: string,
    percent: string,
    files: string,
    depth: int,
    expanded: bool,
    has-children: bool,
}

/// One file type in the footer: its share of the scan and its tile colour. Text is formatted by the host.
export struct TypeChip {
    label: string,
    percent: string,
    share: float,
    color: color,
}

/// Sort column ids shared with the host: 0 name, 1 size, 2 percent of parent, 3 files.
component HeaderCell inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    in property <bool> descending;
    in property <bool> right-aligned: true;
    callback clicked();
    height: 28px;
    background: touch.has-hover ? Palette.alternate-background : transparent;
    border-width: focus.has-focus ? 2px : 0px;
    border-color: Palette.accent-background;
    focus := FocusScope {
        accessible-role: button;
        accessible-label: "Sort by \{root.text}";
        accessible-action-default => { root.clicked(); }
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.clicked();
                return accept;
            }
            return reject;
        }
        Text {
            x: 8px;
            width: parent.width - 16px;
            height: parent.height;
            vertical-alignment: center;
            horizontal-alignment: root.right-aligned ? right : left;
            font-weight: 600;
            text: root.text + (root.active ? (root.descending ? " ▼" : " ▲") : "");
            overflow: elide;
        }
        touch := TouchArea { clicked => { root.clicked(); focus.focus(); } }
    }
}

export component MainWindow inherits Window {
    title: "Volatus";
    icon: @image-url("../assets/volatus.png");
    // The window must start transparent so the Mica backdrop shows through (set at window creation).
    // If Mica is not available, the host sets `mica` to false and the Fluent palette fills the window.
    in property <bool> mica: true;
    /// The system theme is dark. The host draws the treemap for it.
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;
    changed dark => { root.theme-changed(); }
    background: root.mica ? transparent : Palette.background;
    preferred-width: 1100px;
    preferred-height: 700px;
    min-height: 400px;

    in property <bool> scanning;
    in property <string> banner;
    // True while the folder dialog is open.
    in property <bool> browsing;
    in property <bool> banner-is-error;

    // Start screen
    /// The start screen is shown: nothing is scanning and no result is shown.
    in property <bool> start-screen: true;
    /// One button per ready drive.
    in property <[DriveButton]> drive-buttons;
    /// The host is still looking for drives.
    in property <bool> drives-loading: true;
    /// A scan is finished: "New scan" is offered.
    in property <bool> show-new-scan;

    // File tree
    in property <[TreeRow]> rows;
    in property <int> selected-row: -1;
    in property <int> sort-key: 1;
    in property <bool> sort-descending: true;

    // Treemap
    in property <image> treemap;
    in property <string> treemap-title;
    in property <bool> treemap-can-go-up;
    in property <bool> has-selection;
    in property <length> selection-x;
    in property <length> selection-y;
    in property <length> selection-width;
    in property <length> selection-height;
    /// Text over the treemap when it shows nothing, or "".
    in property <string> map-note;
    /// Labels of the treemap frames.
    in property <[FrameLabel]> labels;

    // File-type footer
    /// The biggest file types of the scan, then "Other".
    in property <[TypeChip]> type-chips;
    /// The host is still counting the file types of the shown scan.
    in property <bool> types-counting;

    // Elevation
    in property <bool> show-elevate;
    in property <string> elevate-note;

    /// A drive button was used. The argument is the drive root, such as "C:\".
    callback scan-drive(string);
    callback choose-folder();
    callback new-scan();
    callback cancel();
    callback tree-select(int);
    callback tree-toggle(int);
    callback tree-sort(int);
    callback treemap-click(float, float);
    callback treemap-open(float, float);
    callback treemap-up();
    /// Key press in the file tree: "up", "down", "left", "right", "enter" or "space".
    callback tree-key(string);
    /// Key press in the treemap: "up", "down", "left", "right", "enter" or "backspace".
    callback map-key(string);
    callback treemap-resized(float, float);
    callback restart-admin();
    /// The system theme changed between light and dark.
    callback theme-changed();

    /// Scrolls the file tree so row `i` is inside the view.
    public function show-row(i: int) {
        if (i * 24px < -list.content-y) {
            list.content-y = -i * 24px;
        } else if ((i + 1) * 24px > -list.content-y + list.visible-height) {
            list.content-y = -((i + 1) * 24px - list.visible-height);
        }
    }

    if root.start-screen : StartScreen {
        width: 100%;
        height: 100%;
        drives: root.drive-buttons;
        loading: root.drives-loading;
        message: root.banner;
        message-is-error: root.banner-is-error;
        browsing: root.browsing;
        scan-drive(drive) => { root.scan-drive(drive); }
        choose-folder => { root.choose-folder(); }
    }
    // The results stay in the tree while the start screen shows, so the file tree keeps its scroll
    // function; hidden, they take no input.
    VerticalBox {
        visible: !root.start-screen;
        width: 100%;
        height: 100%;
        spacing: 12px;
        HorizontalBox {
            padding: 0;
            alignment: start;
            if root.scanning : Button {
                text: "Cancel";
                clicked => { root.cancel(); }
            }
            if root.show-new-scan : Button {
                text: "New scan";
                primary: true;
                clicked => { root.new-scan(); }
            }
            if root.show-elevate : Button {
                text: "Restart as administrator";
                enabled: !root.scanning;
                clicked => { root.restart-admin(); }
            }
        }
        if root.scanning : ProgressIndicator {
            indeterminate: true;
        }
        Text {
            text: root.banner;
            wrap: word-wrap;
            color: root.banner-is-error ? #d13438 : Palette.foreground;
            accessible-role: text;
        }
        if root.elevate-note != "" : Text {
            text: root.elevate-note;
            wrap: word-wrap;
            color: #d13438;
            accessible-role: text;
        }

        HorizontalLayout {
            spacing: 12px;
            // File tree
            // Each pane sits in a Rectangle with `preferred-width: 0px`, so a pane starts at its
            // minimum width and the free space is shared 1 : 5 (a layout cannot take that
            // preferred width itself). The map gets about 51% of the window at 1100 px and more
            // when the window is wider.
            Rectangle {
                horizontal-stretch: 1;
                preferred-width: 0px;
                min-width: 460px;
                VerticalLayout {
                    HorizontalLayout {
                        HeaderCell {
                            horizontal-stretch: 1;
                            text: "Name";
                            right-aligned: false;
                            active: root.sort-key == 0;
                            descending: root.sort-descending;
                            clicked => { root.tree-sort(0); }
                        }
                        HeaderCell {
                            width: 80px;
                            text: "Size";
                            active: root.sort-key == 1;
                            descending: root.sort-descending;
                            clicked => { root.tree-sort(1); }
                        }
                        HeaderCell {
                            width: 104px;
                            text: "% of parent";
                            active: root.sort-key == 2;
                            descending: root.sort-descending;
                            clicked => { root.tree-sort(2); }
                        }
                        HeaderCell {
                            width: 76px;
                            text: "Files";
                            active: root.sort-key == 3;
                            descending: root.sort-descending;
                            clicked => { root.tree-sort(3); }
                        }
                    }
                    tree-focus := FocusScope {
                        vertical-stretch: 1;
                        accessible-role: tree;
                        accessible-label: "File tree";
                        accessible-value: root.selected-row >= 0 ? root.rows[root.selected-row].name : "";
                        key-pressed(event) => {
                            if (Keys.name(event.text) == "") { return reject; }
                            root.tree-key(Keys.name(event.text));
                            return accept;
                        }
                        list := ListView {
                            // Inside the focus ring, so the ring does not cover the last column.
                            x: 2px;
                            y: 2px;
                            width: parent.width - 4px;
                            height: parent.height - 4px;
                            for row[i] in root.rows : Rectangle {
                                height: 24px;
                                background: i == root.selected-row ? Palette.selection-background : (row-touch.has-hover ? Palette.alternate-background : transparent);
                                row-touch := TouchArea { clicked => { root.tree-select(i); tree-focus.focus(); } }
                                HorizontalLayout {
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        HorizontalLayout {
                                            padding-left: 8px + row.depth * 16px;
                                            spacing: 4px;
                                            Rectangle {
                                                width: 16px;
                                                if row.has-children : Text {
                                                    text: row.expanded ? "-" : "+";
                                                    vertical-alignment: center;
                                                    horizontal-alignment: center;
                                                    accessible-role: button;
                                                    accessible-label: row.expanded ? "Collapse \{row.name}" : "Expand \{row.name}";
                                                }
                                                if row.has-children : TouchArea { clicked => { root.tree-toggle(i); tree-focus.focus(); } }
                                            }
                                            Text {
                                                text: row.name;
                                                vertical-alignment: center;
                                                overflow: elide;
                                                color: i == root.selected-row ? Palette.selection-foreground : Palette.foreground;
                                            }
                                        }
                                    }
                                    Text { width: 80px; text: row.size; horizontal-alignment: right; vertical-alignment: center; color: i == root.selected-row ? Palette.selection-foreground : Palette.foreground; }
                                    Text { width: 104px; text: row.percent; horizontal-alignment: right; vertical-alignment: center; color: i == root.selected-row ? Palette.selection-foreground : Palette.foreground; }
                                    Text { width: 76px; text: row.files; horizontal-alignment: right; vertical-alignment: center; color: i == root.selected-row ? Palette.selection-foreground : Palette.foreground; }
                                }
                            }
                        }
                        Rectangle {
                            border-width: tree-focus.has-focus ? 2px : 0px;
                            border-color: Palette.accent-background;
                        }
                    }
                }
            }
            // Treemap
            Rectangle {
                horizontal-stretch: 5;
                preferred-width: 0px;
                min-width: 260px;
                VerticalLayout {
                    spacing: 6px;
                    HorizontalLayout {
                        spacing: 8px;
                        Button {
                            text: "Up";
                            enabled: root.treemap-can-go-up;
                            clicked => { root.treemap-up(); }
                        }
                        Text {
                            text: root.treemap-title;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                    TreemapView {
                        vertical-stretch: 1;
                        source: root.treemap;
                        note: root.map-note;
                        labels: root.labels;
                        has-selection: root.has-selection;
                        selection-x: root.selection-x;
                        selection-y: root.selection-y;
                        selection-width: root.selection-width;
                        selection-height: root.selection-height;
                        clicked(x, y) => { root.treemap-click(x, y); }
                        double-clicked(x, y) => { root.treemap-open(x, y); }
                        key(k) => { root.map-key(k); }
                        resized(w, h) => { root.treemap-resized(w, h); }
                    }
                }
            }
        }

        // File-type footer: a strip with one part per type and the chips under it, in the tile
        // colours. Always there and always 32 px high, so the map keeps its size when a scan
        // is shown or the chips arrive (a size change would lay the map out a second time).
        VerticalLayout {
            spacing: 6px;
            if root.types-counting || root.type-chips.length == 0 : Text {
                height: 32px;
                // The tree has rows only while a scan is shown.
                text: root.types-counting ? "Counting file types." : (root.rows.length > 0 ? "No file sizes to show." : "");
                vertical-alignment: center;
                color: Palette.foreground.transparentize(30%);
                accessible-role: text;
            }
            if !root.types-counting && root.type-chips.length > 0 : Rectangle {
                height: 10px;
                border-radius: 3px;
                clip: true;
                HorizontalLayout {
                    spacing: 1px;
                    for chip in root.type-chips : Rectangle {
                        horizontal-stretch: chip.share;
                        min-width: 0px;
                        preferred-width: 0px;
                        background: chip.color;
                    }
                }
            }
            if !root.types-counting && root.type-chips.length > 0 : HorizontalLayout {
                height: 16px;
                spacing: 12px;
                alignment: start;
                for chip in root.type-chips : HorizontalLayout {
                    spacing: 4px;
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 9px;
                            height: 9px;
                            border-radius: 2px;
                            background: chip.color;
                        }
                    }
                    Text {
                        text: chip.label + " " + chip.percent;
                        vertical-alignment: center;
                        overflow: elide;
                        color: Palette.foreground.transparentize(20%);
                        accessible-role: text;
                    }
                }
            }
        }
    }
}
